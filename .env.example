# Database (PostgreSQL) — domain-separated connections (ELYO-104)
# One cluster, one DB per domain, one runtime role per connection.
DB_CONNECTION=identity
DB_HOST=postgres
DB_PORT=5432

# Legacy bootstrap DB + superuser (POSTGRES_* for the container; kept for BC,
# still used by n8n). Not the app's default connection anymore.
DB_DATABASE=elyo
DB_USERNAME=elyo
DB_PASSWORD=elyo_secret

# Per-connection credentials (map to the PG roles created by the initdb script).
#
# NOTE (ELYO-106 runtime split): since the API runs as three containers, the
# DB_*_USERNAME/PASSWORD pairs are assigned PER SERVICE in docker-compose.yml,
# not from this file. Each runtime receives only its own role:
#
#   api-identity  identity=elyo_identity_rt  audit=elyo_identity_rt
#   api-employee  identity=elyo_employee_rt  mapping=elyo_mapping_svc
#                 health=elyo_employee_rt    audit=elyo_employee_rt
#   api-company   identity=elyo_company_rt   audit=elyo_company_rt
#   migrate       every connection=elyo_migrator (one-shot service only)
#   api-tooling   all runtime roles + migrator — LOCAL DEVELOPMENT ONLY
#
# The values below stay as the fallback for non-Docker/local-PHP usage and as
# documentation of the database names.
DB_IDENTITY_DATABASE=elyo_identity
DB_IDENTITY_USERNAME=elyo_identity_rt
DB_IDENTITY_PASSWORD=identity_rt_dev
DB_MAPPING_DATABASE=elyo_subject_mapping
DB_MAPPING_USERNAME=elyo_mapping_svc
DB_MAPPING_PASSWORD=mapping_svc_dev
DB_HEALTH_DATABASE=elyo_health
DB_HEALTH_USERNAME=elyo_employee_rt
DB_HEALTH_PASSWORD=employee_rt_dev
DB_AUDIT_DATABASE=elyo_audit
DB_AUDIT_USERNAME=elyo_employee_rt
DB_AUDIT_PASSWORD=employee_rt_dev

# Migrator role: owns the schema and runs all DDL (php artisan elyo:migrate-fresh).
# Reaches a container only through the one-shot `migrate` service and the local
# `api-tooling` service — never a deployed runtime (ADR-001 §2.4).
DB_MIGRATOR_USERNAME=elyo_migrator
DB_MIGRATOR_PASSWORD=migrator_dev

# Runtime-role passwords. Consumed by infra/postgres/initdb when the roles are
# created AND by docker-compose.yml when each API service is handed its own
# credentials. Docker Compose requires every value: missing values stop startup
# instead of silently using a password. Use Docker secrets outside local
# development.
ELYO_IDENTITY_RT_PASSWORD=identity_rt_dev
ELYO_EMPLOYEE_RT_PASSWORD=employee_rt_dev
ELYO_COMPANY_RT_PASSWORD=company_rt_dev
ELYO_MAPPING_SVC_PASSWORD=mapping_svc_dev
ELYO_MIGRATOR_PASSWORD=migrator_dev

# Dedicated mapping-domain encryption, lookup, and orphan-recovery keys.
# Generate independent secrets; never reuse APP_KEY.
# Handed only to the services that own the mapping connection (api-employee,
# migrate, api-tooling). api-identity and api-company never receive them.
MAPPING_ENCRYPTION_KEY=
MAPPING_HMAC_KEY=
MAPPING_SUBJECT_DERIVATION_KEY=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@elyo.de"
MAIL_FROM_NAME="${APP_NAME}"

# External APIs & Integrations (from legacy)
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_HMAC_SECRET=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@elyo.de

# Angular. Single base URL for all three API runtimes — nginx (port 8080) routes
# by path prefix, so the frontend is unaware of the runtime split.
NG_APP_API_URL=http://localhost:8080/api

# Laravel
APP_NAME=ELYO_API
APP_ENV=local
# Runtime profiles: identity, employee, company. full is local/testing only.
# docker-compose.yml sets ELYO_RUNTIME per API service; this value applies to
# local, non-Docker PHP runs only.
ELYO_RUNTIME=full
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
