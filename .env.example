# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=elyo
DB_USERNAME=elyo
DB_PASSWORD=elyo_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Mail (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@elyo.de"
MAIL_FROM_NAME="${APP_NAME}"

# External APIs & Integrations (from legacy)
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_HMAC_SECRET=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@elyo.de

# Angular
NG_APP_API_URL=http://localhost:8000/api

# Laravel
APP_NAME=ELYO_API
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
