<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="boundary">
            <directory>tests/Boundary</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="ELYO_RUNTIME" value="full" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- D9 (Postgres-only): the suite runs against the elyo_*_test databases
             in the docker Postgres container. Each runtime connection is pointed
             at its *_test database with forced runtime/migrator role names;
             passwords come from the container environment (.env / docker-compose).
             Schema is built with the migrator role via the *_migrator connections;
             queries run with the runtime roles so grants are exercised. Requires docker:
             `docker compose exec api php artisan test`. -->
        <env name="DB_CONNECTION" value="identity" force="true"/>
        <env name="DB_IDENTITY_DATABASE" value="elyo_identity_test" force="true"/>
        <env name="DB_IDENTITY_USERNAME" value="elyo_identity_rt" force="true"/>
        <env name="DB_MAPPING_DATABASE" value="elyo_subject_mapping_test" force="true"/>
        <env name="DB_MAPPING_USERNAME" value="elyo_mapping_svc" force="true"/>
        <env name="DB_HEALTH_DATABASE" value="elyo_health_test" force="true"/>
        <env name="DB_HEALTH_USERNAME" value="elyo_employee_rt" force="true"/>
        <env name="DB_AUDIT_DATABASE" value="elyo_audit_test" force="true"/>
        <env name="DB_AUDIT_USERNAME" value="elyo_employee_rt" force="true"/>
        <env name="DB_MIGRATOR_USERNAME" value="elyo_migrator" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
